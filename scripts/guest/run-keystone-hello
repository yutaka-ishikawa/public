#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
bb=${KEYSTONE_GUEST_BUSYBOX:-/usr/libexec/keystone/busybox}
"$bb" mountpoint -q /proc || "$bb" mount -t proc proc /proc
"$bb" mountpoint -q /sys || "$bb" mount -t sysfs sysfs /sys
example=/usr/share/keystone/examples/hello.ke
if [ ! -x "$example" ]; then
 echo "Missing $example. Boot the Keystone rootfs, or rebuild it with build-install-keystone.sh." >&2
 exit 1
fi
if [ ! -e /dev/keystone_enclave ]; then
 module="/usr/lib/modules/$(uname -r)/extra/keystone-driver.ko"
 if [ ! -f "$module" ]; then echo "Missing matching kernel module: $module" >&2; exit 1; fi
 if command -v insmod >/dev/null 2>&1; then insmod "$module"; else "$bb" insmod "$module"; fi
fi
exec "$example" "$@"
