diff --git a/target/riscv/tcg/csr.c b/target/riscv/tcg/csr.c
index b24a344..30fccc7 100644
--- a/target/riscv/tcg/csr.c
+++ b/target/riscv/tcg/csr.c
@@ -293,6 +293,190 @@ static RISCVException any(CPURISCVState *env, int csrno)
     return RISCV_EXCP_NONE;
 }
 
+/*
+ * K3 PMACFG0 (0x7de): opt-in M-mode CSR compatibility register.
+ * Value read/write and CSRRS/CSRRC semantics are modeled. The K3 PMA
+ * memory-type effects are NOT modeled: this is a boot compatibility shim,
+ * and must not be relied on for hardware-equivalent PMA security.
+ */
+#define CSR_K3_TCMCFG   0x5db
+#define CSR_K3_MHCR     0x7c1
+#define CSR_K3_PMACFG0 0x7de
+#define CSR_K3_ML2SETUP 0x7f0
+#define CSR_K3_MSETUP    0x7c0
+#define CSR_K3_MCACHEOP  0x7c2
+#define CSR_K3_PERF_CTRL 0x7d0
+#define CSR_K3_PREF_CTRL 0x7d1
+#define CSR_K3_ML2HINT   0x7f7
+#define CSR_K3_MVMD1     0xbf9
+
+static RISCVException k3_pmacfg0_enabled(CPURISCVState *env, int csrno)
+{
+    return riscv_cpu_cfg(env)->k3_pmacfg ? RISCV_EXCP_NONE :
+           RISCV_EXCP_ILLEGAL_INST;
+}
+
+/* Stage 4 register compatibility. No TCM mapping/cache side effects. */
+static RISCVException k3_stage4_csr_enabled(CPURISCVState *env, int csrno)
+{
+    if (!riscv_cpu_cfg(env)->k3_pmacfg ||
+        (!env->debugger && env->priv != PRV_M)) {
+        return RISCV_EXCP_ILLEGAL_INST;
+    }
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException read_k3_tcmcfg(CPURISCVState *env, int csrno,
+                                    target_ulong *val)
+{
+    *val = env->k3_tcmcfg;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_k3_tcmcfg(CPURISCVState *env, int csrno,
+                                     target_ulong val, uintptr_t ra)
+{
+    env->k3_tcmcfg = val;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException read_k3_mhcr(CPURISCVState *env, int csrno,
+                                  target_ulong *val)
+{
+    *val = env->k3_mhcr;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_k3_mhcr(CPURISCVState *env, int csrno,
+                                   target_ulong val, uintptr_t ra)
+{
+    env->k3_mhcr = val;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException read_k3_pmacfg0(CPURISCVState *env, int csrno,
+                                      target_ulong *val)
+{
+    *val = env->k3_pmacfg0;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_k3_pmacfg0(CPURISCVState *env, int csrno,
+                                       target_ulong val, uintptr_t ra)
+{
+    env->k3_pmacfg0 = val;
+    return RISCV_EXCP_NONE;
+}
+
+/*
+ * K3 ML2SETUP (0x7f0): boot-compatibility storage only.
+ * This does NOT emulate hardware L2-cache setup or its side effects.
+ * Gated by the same opt-in K3 vendor CSR compatibility CPU property.
+ */
+static RISCVException read_k3_ml2setup(CPURISCVState *env, int csrno,
+                                       target_ulong *val)
+{
+    *val = env->k3_ml2setup;
+    return RISCV_EXCP_NONE;
