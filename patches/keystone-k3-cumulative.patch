diff --git a/sm/src/platform/spacemit_k3/k3_b1_handoff.c b/sm/src/platform/spacemit_k3/k3_b1_handoff.c
new file mode 100644
index 0000000..a660929
--- /dev/null
+++ b/sm/src/platform/spacemit_k3/k3_b1_handoff.c
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#include "k3_b1_handoff.h"
+
+#if defined(K3_KEY_PROVIDER_HW_ROT_A) || defined(K3_KEY_PROVIDER_TEST_ONLY)
+#error "K3 B1 backend cannot be built as HW RoT or TEST_ONLY provider"
+#endif
+
+static int valid_range(uint64_t base, uint64_t size)
+{
+    return size != 0 && base <= UINT64_MAX - size;
+}
+
+int k3_b1_validate_descriptor(const struct k3_b1_descriptor *d,
+                              const struct k3_b1_expected_layout *trusted)
+{
+    uint64_t region_end, key_end, reserved_end;
+
+    if (!d || !trusted)
+        return -1;
+    if (d->magic != K3_B1_MAGIC || d->version != K3_B1_VERSION ||
+        d->header_bytes != sizeof(*d) ||
+        d->key_purpose != K3_B1_KEY_ATTESTATION)
+        return -1;
+    if (!trusted->expected_key_bytes ||
+        d->key_bytes != trusted->expected_key_bytes ||
+        d->boot_epoch < trusted->min_boot_epoch)
+        return -1;
+    if ((d->key_physical_address & (K3_B1_PAGE_SIZE - 1)) != 0 ||
+        (trusted->reserved_base & (K3_B1_PAGE_SIZE - 1)) != 0 ||
+        (trusted->reserved_bytes & (K3_B1_PAGE_SIZE - 1)) != 0 ||
+        (d->protected_region_bytes & (K3_B1_PAGE_SIZE - 1)) != 0)
+        return -1;
+    if (!valid_range(d->key_physical_address, d->protected_region_bytes) ||
+        !valid_range(trusted->reserved_base, trusted->reserved_bytes) ||
+        !valid_range(d->key_physical_address, d->key_bytes))
+        return -1;
+    region_end = d->key_physical_address + d->protected_region_bytes;
+    key_end = d->key_physical_address + d->key_bytes;
+    reserved_end = trusted->reserved_base + trusted->reserved_bytes;
+    if (d->key_physical_address < trusted->reserved_base ||
+        region_end > reserved_end || key_end > region_end)
+        return -1;
+    return 0;
+}
+
+int k3_b1_platform_provision(void)
+{
+    /* NOT YET AUTHORIZED: a software descriptor does not establish trust.
+     * Missing: authenticated prior-stage handoff, proven physical CPU/IOPMP
+     * isolation before key placement, entropy, CSR/IOPMP state readback,
+     * and the single-owner all-hart handoff. No key is touched here. */
+    return -1;
+}
+
+int k3_key_provider_initialize(void)
+{
+    return k3_b1_platform_provision();
+}
diff --git a/sm/src/platform/spacemit_k3/k3_b1_handoff.h b/sm/src/platform/spacemit_k3/k3_b1_handoff.h
new file mode 100644
index 0000000..2aac0dd
--- /dev/null
+++ b/sm/src/platform/spacemit_k3/k3_b1_handoff.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef KEYSTONE_K3_B1_HANDOFF_H
+#define KEYSTONE_K3_B1_HANDOFF_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+/* Metadata only. This structure NEVER contains plaintext key bytes. */
+#define K3_B1_MAGIC UINT32_C(0x3142314b) /* "K1B1" wire marker */
+#define K3_B1_VERSION UINT16_C(1)
+#define K3_B1_KEY_ATTESTATION UINT32_C(1)
+#define K3_B1_PAGE_SIZE UINT64_C(4096)
+
+struct k3_b1_descriptor {
+    uint32_t magic;
+    uint16_t version;
+    uint16_t header_bytes;
+    uint64_t key_physical_address;
+    uint64_t protected_region_bytes;
+    uint32_t key_bytes;
+    uint32_t key_purpose;
+    uint64_t boot_epoch;
+};
+
+/* Values here must come from independently authenticated boot evidence.
+ * This structure is NEVER accepted as a security proof from an OS caller. */
+struct k3_b1_expected_layout {
+    uint64_t reserved_base;
+    uint64_t reserved_bytes;
+    uint64_t min_boot_epoch;
+    uint32_t expected_key_bytes;
+};
+
+/* Pure, side-effect-free preflight. Return 0 on valid syntax and bounds.
+ * Returning 0 DOES NOT AUTHORIZE reading a plaintext key. */
+int k3_b1_validate_descriptor(const struct k3_b1_descriptor *d,
+                              const struct k3_b1_expected_layout *trusted);
+
+/* The platform is fail-closed until verified boot, CPU+DMA isolation,
+ * full-hart ownership and secure entropy have been independently proven.
+ * There is intentionally no caller-controlled "verified" flag. */
+int k3_b1_platform_provision(void);
+
+/* Shared provider entry point: future A provider can reuse the caller ABI. */
+int k3_key_provider_initialize(void);
+
+#endif
