diff --git a/sm/tests/k3_ipi_failure/k3_pmp_ipi_failure_test.c b/sm/tests/k3_ipi_failure/k3_pmp_ipi_failure_test.c
new file mode 100644
index 0000000..04d9ca4
--- /dev/null
+++ b/sm/tests/k3_ipi_failure/k3_pmp_ipi_failure_test.c
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Directly compile the production K3 PMP IPI transport into a host harness.
+ * The fake hart exits with code 77 if production code calls sbi_hart_hang().
+ */
+#include <assert.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/wait.h>
+#include "../../src/k3_pmp_ipi_transport.c"
+
+static struct sbi_scratch hart;
+static struct sbi_domain domain;
+static struct k3_pmp_mailbox mailbox;
+static int apply_returns_error;
+static int calls;
+static int send_calls;
+
+int sbi_ipi_event_create(const struct sbi_ipi_event_ops *p) { return p ? 1 : -1; }
+void sbi_ipi_event_destroy(u32 id) { (void)id; }
+int sbi_ipi_send_many(ulong a, ulong b, u32 c, void *d)
+{ (void)a; (void)b; (void)c; (void)d; send_calls++; return 0; }
+unsigned long sbi_scratch_alloc_offset(unsigned long size) { return size ? 1 : 0; }
+void sbi_scratch_free_offset(unsigned long offset) { (void)offset; }
+void *sbi_scratch_offset_ptr(struct sbi_scratch *s, unsigned long offset)
+{ assert(s == &hart && offset != 0); return &mailbox; }
+unsigned int sbi_scratch_last_hartindex(void) { return 0; }
+struct sbi_scratch *sbi_hartindex_to_scratch(unsigned int i) { return i == 0 ? &hart : NULL; }
+u32 sbi_hartindex_to_hartid(unsigned int i) { return i; }
+int sbi_hsm_hart_interruptible_mask(struct sbi_domain *d, struct sbi_hartmask *m)
+{ (void)d; m->bits = 1; return 0; }
+int __sbi_hsm_hart_get_state(unsigned int i) { (void)i; return SBI_HSM_STATE_STARTED; }
+struct sbi_domain *sbi_domain_thishart_ptr(void) { return &domain; }
+int sbi_hartmask_test_hartindex(unsigned int i, const struct sbi_hartmask *m)
+{ return !!(m->bits & (1UL << i)); }
+void __attribute__((noreturn)) sbi_hart_hang(void) { _exit(77); }
+static int fake_apply(int region, int operation, uint8_t perms)
+{ (void)region; (void)operation; (void)perms; calls++; return apply_returns_error; }
+
+static void run_case(int failed, int expected_exit)
+{
+  pid_t pid = fork();
+  int status;
+  assert(pid >= 0);
+  if (!pid) {
+    mailbox.state = K3_PMP_MB_IDLE;
+    mailbox.generation = 0;
+    k3_mailbox_offset = 1;
+    k3_apply = fake_apply;
+    apply_returns_error = failed;
+    assert(k3_pmp_mailbox_submit(&mailbox, 1, 2, 3, 0) == 0);
+    k3_pmp_ipi_event_process(&hart);
+    assert(calls == 1);
+    assert(mailbox.state == (failed ? K3_PMP_MB_FAILED : K3_PMP_MB_DONE));
+    _exit(0);
+  }
+  assert(waitpid(pid, &status, 0) == pid);
+  assert(WIFEXITED(status) && WEXITSTATUS(status) == expected_exit);
+}
+int main(void)
+{
+  run_case(0, 0);     /* Normal PMP update still returns from IPI. */
+  run_case(-1, 77);   /* PMP update/readback failure never returns to S-mode. */
+  {
+    const struct k3_pmp_ipi_request req = { .generation = 1 };
+    k3_pmp_ipi_event = 1;
+    k3_mailbox_offset = 1;
+    k3_apply = fake_apply;
+    /* Only hart 0 exists; asking for 0 and 1 must not silently deliver to 0. */
+    assert(k3_pmp_ipi_transport_send(3UL, 0, &req) == SBI_ENOTSUPP);
+    assert(send_calls == 0);
+    /* A request for an entirely nonexistent hart must likewise be rejected. */
+    assert(k3_pmp_ipi_transport_send(2UL, 0, &req) == SBI_ENOTSUPP);
+    assert(send_calls == 0);
+  }
+  return 0;
+}
diff --git a/sm/tools/k3_dev_keypair_host.c b/sm/tools/k3_dev_keypair_host.c
new file mode 100644
index 0000000..8433698
--- /dev/null
+++ b/sm/tools/k3_dev_keypair_host.c
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Host-only helper used by k3_generate_embedded_dev_key.py.
+ * Uses the same SHA3-based Ed25519-like keypair code as the original SM;
+ * standard openssl Ed25519 public keys are NOT compatible here. */
+#include <stdio.h>
+#include <string.h>
+#include "../src/ed25519/ed25519.h"
+
+int main(void)
+{
+    unsigned char seed[32], public_key[32], private_key[64];
+    if (fread(seed, 1, sizeof(seed), stdin) != sizeof(seed))
+        return 1;
+    ed25519_create_keypair(public_key, private_key, seed);
+    memset(seed, 0, sizeof(seed));
+    if (fwrite(public_key, 1, sizeof(public_key), stdout) != sizeof(public_key) ||
+        fwrite(private_key, 1, sizeof(private_key), stdout) != sizeof(private_key))
+        return 2;
+    memset(private_key, 0, sizeof(private_key));
+    return 0;
+}
diff --git a/sm/tools/k3_generate_embedded_dev_key.py b/sm/tools/k3_generate_embedded_dev_key.py
new file mode 100755
index 0000000..751bf5a
--- /dev/null
+++ b/sm/tools/k3_generate_embedded_dev_key.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Generate C material at build time using Keystone's actual SHA3-based keypair.
+
+Development ONLY: the generated file and final firmware disclose the private
+key to anyone who can read the build outputs. No production attestation claim.
+"""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+SCRIPT = Path(__file__).resolve()
+SM = SCRIPT.parent.parent
+DEFAULT = SM / 'src/platform/spacemit_k3/k3_dev_key_generated.inc'
+
+
+def emit_array(name, data):
+    rows = [data[i:i + 12] for i in range(0, len(data), 12)]
+    return 'static const unsigned char ' + name + '[' + str(len(data)) + '] = {\n' + ''.join(
+        '    ' + ', '.join('0x%02x' % b for b in row) + ',\n' for row in rows
+    ) + '};\n'
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, default=DEFAULT)
+    parser.add_argument('--opensbi-include', type=Path, required=True,
+                        help='Path to OpenSBI include/; used only to compile host helper')
+    parser.add_argument('--cc', default='cc')
+    args = parser.parse_args()
+    output = args.output.resolve()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    if output.exists():
+        raise SystemExit('refusing to overwrite existing key; delete it explicitly for key rotation')
+    with tempfile.TemporaryDirectory(prefix='k3-devkey-') as tmp:
+        helper = Path(tmp) / 'keygen'
+        src = SM / 'src'
+        cmd = [args.cc, '-std=c11', '-O2', '-D__riscv_xlen=64',
+               '-I' + str(args.opensbi_include.resolve()), '-o', str(helper),
+               str(SCRIPT.parent / 'k3_dev_keypair_host.c'),
+               str(src / 'ed25519/keypair.c'), str(src / 'ed25519/ge.c'),
+               str(src / 'ed25519/fe.c'), str(src / 'sha3/sha3.c')]
+        subprocess.run(cmd, check=True)
+        seed = bytearray(os.urandom(32))
+        try:
+            pair = subprocess.run([str(helper)], input=seed, stdout=subprocess.PIPE,
+                                  stderr=subprocess.PIPE, check=True).stdout
+        finally:
+            seed[:] = bytes(32)
+    if len(pair) != 96 or not any(pair[:32]) or not any(pair[32:]):
+        raise SystemExit('host keypair generator returned invalid output')
+    material = ('/* AUTOMATICALLY GENERATED. DEVELOPMENT ONLY. DO NOT DISTRIBUTE.\n'
+                ' * A firmware image containing this material exposes the private key.\n'
+                ' * This is not a hardware-bound or manufacturer-certified attestation key. */\n'
+                '#define K3_DEV_KEY_MATERIAL_PRESENT 1\n' +
+                emit_array('k3_dev_pubkey', pair[:32]) +
+                emit_array('k3_dev_privkey', pair[32:]))
+    fd = os.open(output, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+    with os.fdopen(fd, 'w', encoding='ascii') as stream:
+        stream.write(material)
+    print('Generated development-only key include:', output)
+    print('Public key SHA-256:', __import__('hashlib').sha256(pair[:32]).hexdigest())
+    print('Private key not printed. NEVER publish firmware with this key as trusted attestation.')
+
+if __name__ == '__main__':
+    main()
diff --git a/sm/tools/k3_rv64_compile_audit.py b/sm/tools/k3_rv64_compile_audit.py
new file mode 100755
index 0000000..9e34162
--- /dev/null
+++ b/sm/tools/k3_rv64_compile_audit.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Compile all real Keystone SM translation units against a chosen K3 OpenSBI.
+
+Diagnostic-only: no firmware image, no emulated platform, no crypto keys,
+no claim of valid physical addresses. Supply _build-only_ parameters in an
+isolated compiler invocation. Failure is intentional until integration lands.
+"""
+import argparse
+import pathlib
+import subprocess
+import sys
+
+SOURCES = [
+    'attest.c', 'cpu.c', 'crypto.c', 'enclave.c', 'ipi.c',
+    'k3_pmp_ipi_transport.c', 'pmp.c', 'sm.c', 'sm-sbi.c',
+    'sm-sbi-opensbi.c', 'sbi_trap_hack.c', 'thread.c',
+    'plugins/multimem.c', 'plugins/plugins.c',
+    'sha3/sha3.c', 'ed25519/fe.c', 'ed25519/ge.c',
+    'ed25519/keypair.c', 'ed25519/sc.c', 'ed25519/sign.c',
+    'hkdf_sha3_512/hkdf_sha3_512.c', 'hmac_sha3/hmac_sha3.c',
+    'mprv.S', 'trap.S', 'platform/spacemit_k3/platform.c',
+    'platform/spacemit_k3/k3_dev_embedded_key.c',
+    'platform/spacemit_k3/k3_b1_handoff.c',
+]
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('--opensbi', type=pathlib.Path, required=True)
+    p.add_argument('--output', type=pathlib.Path, required=True)
+    p.add_argument('--compiler', default='clang')
+    p.add_argument('--dev-embedded-key', action='store_true',
+                   help='Diagnostic only: compile with build-time-generated dev key. Never production.')
+    a=p.parse_args()
+    sm=pathlib.Path(__file__).resolve().parents[1]/'src'
+    a.output.mkdir(parents=True,exist_ok=True)
+    flags=['--target=riscv64-unknown-elf','-march=rv64imafdc_zicsr_zifencei',
+           '-mabi=lp64','-mcmodel=medany','-fPIE','-ffreestanding','-fno-builtin',
+           '-fno-stack-protector','-D__riscv_xlen=64',
+           # SM is linked into OpenSBI; no standalone SM address macros.
+           '-DKEYSTONE_K3_PMP_N_REG=16',
+           '-DK3_QEMU_PMP16=1',
+           '-DTARGET_PLATFORM_HEADER="platform/spacemit_k3/platform.h"',
+           '-I'+str(sm),'-I'+str(a.opensbi/'include'),
+           '-I'+str(a.opensbi/'platform/generic/include'),
+           '-I'+str(sm.parent/'../sdk/include'),'-I'+str(sm.parent.parent/'sdk/include/shared'),'-Wno-unused-function']
+    if a.dev_embedded_key:
+        flags.append('-DKEYSTONE_K3_DEV_EMBED_KEY=1')
+    failed=[]
+    for src in SOURCES:
+        s=sm/src
+        o=a.output/(src.replace('/','__').rsplit('.',1)[0]+'.o')
+        o.parent.mkdir(parents=True,exist_ok=True)
+        cmd=[a.compiler,*flags,'-c',str(s),'-o',str(o)]
+        r=subprocess.run(cmd,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+        print(f'{"PASS" if r.returncode==0 else "FAIL"} {src}',flush=True)
+        if r.stdout: print(r.stdout[-6000:],flush=True)
+        if r.returncode: failed.append(src)
+    print(f'RESULT: {len(SOURCES)-len(failed)}/{len(SOURCES)} translation units compiled; failures={failed}')
+    return 1 if failed else 0
+if __name__=='__main__': sys.exit(main())
