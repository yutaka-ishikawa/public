@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+"""Static wiring regression: does not claim real-Hart PMP or IPI completion."""
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+init = (ROOT / 'lib/sbi/sbi_init.c').read_text()
+objects = (ROOT / 'platform/generic/objects.mk').read_text()
+platform = (ROOT / 'platform/generic/spacemit/spacemit_k3.c').read_text()
+sm = (ROOT.parent / 'keystone/sm/src/ipi.c').read_text()
+transport = (ROOT.parent / 'keystone/sm/src/k3_pmp_ipi_transport.c').read_text()
+checks = {
+    'Cold boot registers after OpenSBI IPI init': bool(re.search(
+        r'rc = sbi_ipi_init\(scratch, true\);.*?'
+        r'#ifdef CONFIG_K3_KEYSTONE_SM(?:(?!#endif).)*?rc = k3_pmp_sync_initialize\(\);'
+        r'.*?#endif', init, flags=re.S)),
+    'Single cold registration in OpenSBI': init.count('rc = k3_pmp_sync_initialize();') == 1,
+    'Warm IPI init does not reregister': 'k3_pmp_sync_initialize' not in
+       init[init.index('static void __noreturn init_warm_startup'):],
+    'Existing event binds verified local PMP apply': bool(re.search(
+        r'k3_pmp_ipi_transport_bind_apply\(k3_pmp_apply_verified\)', sm)),
+    'Transport uses ordinary returning process handler': bool(re.search(
+        r'\.process\s*=\s*k3_pmp_ipi_event_process', transport)),
+    'Transport checks real mailbox completion': 'k3_pmp_mailbox_check(' in transport,
+    'Diagnostic opt-in requires SM linker input': 'KEYSTONE_K3_SM_LINK_PROBE=<SM link-only object>' in objects,
+    'Diagnostic is not claimed boot-ready':
+        '#if defined(CONFIG_K3_KEYSTONE_SM) && !defined(K3_KEYSTONE_DIAGNOSTIC_LINK)' in platform
+        and 'Runtime S-mode admission' in platform,
+    'Cold pre-S-mode requires verified layout and SM readiness':
+        'k3_pmp_boot_partition_admit(' in init
+        and 'sm_init unavailable' in init and 'sbi_hart_hang();' in init,
+}
+for name, ok in checks.items():
+    print(f'{"PASS" if ok else "FAIL"} {name}')
+assert all(checks.values()), 'K3 integration wiring failed static regression'
+print(f'RESULT: {len(checks)}/{len(checks)} PASS (source-level only)')
diff --git a/tests/test_k3_pmp_diag_check.py b/tests/test_k3_pmp_diag_check.py
new file mode 100644
index 00000000..2fc88c79
--- /dev/null
+++ b/tests/test_k3_pmp_diag_check.py
@@ -0,0 +1,43 @@
+import importlib.util
+from pathlib import Path
+import unittest
+
+p = Path(__file__).resolve().parents[1] / 'scripts/k3_pmp_diag_check.py'
+spec = importlib.util.spec_from_file_location('inventory', p)
+inventory = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(inventory)
+
+
+def sample(h, count=2, smepmp=0):
+    lines = [f'K3_PMP_DIAG hart={h} count={count} gran=2 smepmp={smepmp}']
+    if smepmp:
+        lines.append(f'K3_PMP_DIAG hart={h} mseccfg=0x0')
+    for i in range(count):
+        lines.append(f'K3_PMP_DIAG hart={h} idx={i} prot=0x0 base=0x0 log2len=0')
+    lines.append(f'K3_PMP_DIAG hart={h} end=1')
+    return '\n'.join(lines)
+
+
+class InventoryTest(unittest.TestCase):
+    def test_full_16_harts(self):
+        report = inventory.inspect('\n'.join(sample(i, smepmp=(i & 1)) for i in range(16)))
+        self.assertTrue(report['inventory_complete'])
+        self.assertTrue(report['NOT_SECURITY_PROOF'])
+    def test_only_boot_hart_not_complete(self):
+        self.assertFalse(inventory.inspect(sample(0))['inventory_complete'])
+    def test_duplicate_entry_rejected(self):
+        log = sample(0).replace('K3_PMP_DIAG hart=0 end=1',
+                'K3_PMP_DIAG hart=0 idx=0 prot=0x0 base=0x0 log2len=0\nK3_PMP_DIAG hart=0 end=1')
+        self.assertFalse(inventory.inspect(log, 1)['inventory_complete'])
+    def test_resume_last_snapshot(self):
+        self.assertTrue(inventory.inspect(sample(7) + '\n' + sample(7), 1)['inventory_complete'])
+    def test_missing_end(self):
+        self.assertFalse(inventory.inspect(sample(2).replace('K3_PMP_DIAG hart=2 end=1',''), 1)['inventory_complete'])
+    def test_missing_entry(self):
+        self.assertFalse(inventory.inspect(sample(2).replace('K3_PMP_DIAG hart=2 idx=1 prot=0x0 base=0x0 log2len=0',''), 1)['inventory_complete'])
+    def test_read_failure(self):
+        self.assertFalse(inventory.inspect(sample(2).replace('idx=1 prot=0x0 base=0x0 log2len=0','idx=1 error=-1'), 1)['inventory_complete'])
+    def test_mseccfg_unknown(self):
+        self.assertFalse(inventory.inspect(sample(1, smepmp=1).replace('K3_PMP_DIAG hart=1 mseccfg=0x0\n',''), 1)['inventory_complete'])
+
+if __name__ == '__main__': unittest.main()
