diff --git a/include/sbi/k3_a1_csr_preflight.h b/include/sbi/k3_a1_csr_preflight.h
new file mode 100644
index 00000000..56fdf2e2
--- /dev/null
+++ b/include/sbi/k3_a1_csr_preflight.h
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* K3 A1-E: read-only local PMP shape preflight, NOT an ownership proof.
+ * This is deliberately conservative. Hardware capabilities, CSR snapshots,
+ * cross-Hart agreement, address-specific priorities and M-mode holds still
+ * require independent verification before any PMP write or S-mode entry.
+ */
+#ifndef __K3_A1_CSR_PREFLIGHT_H__
+#define __K3_A1_CSR_PREFLIGHT_H__
+#include <stdint.h>
+#define K3_A1_CSR_MAX 16U
+#define K3_A1_CSR_A 0x18U
+#define K3_A1_CSR_NAPOT 0x18U
+#define K3_A1_CSR_RWX 0x07U
+#define K3_A1_CSR_LOCK 0x80U
+/* Bit meanings from RISC-V Smepmp mseccfg, not an extension-presence test. */
+#define K3_A1_CSR_MSECCFG_POLICY 0x07U
+
+enum k3_a1_preflight_result {
+ K3_A1_PF_OK=0, K3_A1_PF_BAD_INPUT=-1,
+ K3_A1_PF_ACTIVE_SMEPMP=-2, K3_A1_PF_NO_GLOBAL_ALLOW=-3,
+ K3_A1_PF_SHADOWED=-4, K3_A1_PF_LOCKED=-5,
+ K3_A1_PF_NO_SLOTS=-6, K3_A1_PF_AMBIGUOUS=-7
+};
+struct k3_a1_csr_measured_entry {
+ uint64_t prot, addr;
+ unsigned int log2len;
+};
+struct k3_a1_csr_measured {
+ unsigned int count, granularity;
+ unsigned int pmp_addrbits; /* implemented PMPADDR bits, not RV64 XLEN */
+ unsigned int mseccfg_valid;
+ uint64_t mseccfg;
+ struct k3_a1_csr_measured_entry entry[K3_A1_CSR_MAX];
+};
+struct k3_a1_local_candidate {
+ unsigned int old_allow, fallback;
+ uint16_t firmware_entries, free_keystone_entries;
+};
+/* This gate only establishes structural suitability of a *local* legacy-PMP
+ * image. No caller may treat PF_OK as permission to transfer ownership.
+ * If anything is ambiguous, reject and preserve the existing build gate.
+ */
+static inline int k3_a1_preflight_local(
+ const struct k3_a1_csr_measured *m, struct k3_a1_local_candidate *out)
+{
+ unsigned int i, old=K3_A1_CSR_MAX, fallback;
+ uint16_t fw=0, free_mask=0;
+ if (!m || !out || m->count < 5 || m->count > K3_A1_CSR_MAX ||
+     m->granularity > 64 ||
+     m->pmp_addrbits == 0 || m->pmp_addrbits > 62)
+  return K3_A1_PF_BAD_INPUT;
+#ifdef K3_QEMU_PMP16
+ /* Emulator contract: all 16 harts expose exactly 16 PMP entries.
+  * This is deliberately not the physical K3 A100 PMP count. */
+ if (m->count != 16U) return K3_A1_PF_BAD_INPUT;
+#endif
+ /* Check *active* mode bits. Having the Smepmp extension is not denial. */
+ if (m->mseccfg_valid && (m->mseccfg & K3_A1_CSR_MSECCFG_POLICY))
+  return K3_A1_PF_ACTIVE_SMEPMP;
+ for (i=0;i<m->count;i++) {
+  const struct k3_a1_csr_measured_entry *e=&m->entry[i];
+  unsigned int mode=(unsigned int)e->prot & K3_A1_CSR_A;
+  if (e->prot & ~(uint64_t)0xffU) return K3_A1_PF_BAD_INPUT;
+  if (mode!=0 && mode!=0x08U && mode!=0x10U && mode!=0x18U)
+   return K3_A1_PF_BAD_INPUT;
+  /* pmp_get() can decode a full-coverage NAPOT as order 57
+   * on a machine with 54 implemented PMPADDR bits. Comparing against
+   * RV64 XLEN (64) incorrectly rejects this valid fallback.
+   */
+  if (mode==K3_A1_CSR_NAPOT && e->addr==0 &&
+      e->log2len >= m->pmp_addrbits + 2U &&
+      ((unsigned int)e->prot & K3_A1_CSR_RWX)==K3_A1_CSR_RWX) {
+   if (old!=K3_A1_CSR_MAX) return K3_A1_PF_AMBIGUOUS;
+   if (e->prot & K3_A1_CSR_LOCK) return K3_A1_PF_LOCKED;
+   old=i;
+  }
+ }
+ if (old==K3_A1_CSR_MAX) return K3_A1_PF_NO_GLOBAL_ALLOW;
+ /* A1-E root-domain layout: all OpenSBI PMP entries (grants or denies),
+  * then untouched Keystone slots, with all-range fallback last. */
+ if (old == m->count - 1U) {
+  unsigned int seen_free = 0;
+  for (i=0; i<old; i++) {
+   const struct k3_a1_csr_measured_entry *e=&m->entry[i];
+   if (e->prot & K3_A1_CSR_LOCK) return K3_A1_PF_LOCKED;
+   if (e->prot & K3_A1_CSR_A) {
+    if (seen_free)
+     return K3_A1_PF_SHADOWED;
+    fw |= (uint16_t)(1U << i);
+   } else {
+    seen_free = 1;
+    free_mask |= (uint16_t)(1U << i);
+   }
+  }
+  if (!fw || __builtin_popcount((unsigned int)free_mask)<3)
+   return K3_A1_PF_NO_SLOTS;
+  out->old_allow = old;
+  out->fallback = old;
+  out->firmware_entries = fw;
+  out->free_keystone_entries = free_mask;
+  return K3_A1_PF_OK;
+ }
+ /* Denies must take priority over the old broad allow, and all active
+  * entries after it would be unknown aliases for the Keystone PMP plan. */
+ for (i=0;i<old;i++) {
+  const struct k3_a1_csr_measured_entry *e=&m->entry[i];
+  if (!((unsigned int)e->prot & K3_A1_CSR_A) ||
+      (e->prot & K3_A1_CSR_RWX)) return K3_A1_PF_SHADOWED;
+  fw |= (uint16_t)(1U<<i);
+ }
+ if (!fw) return K3_A1_PF_SHADOWED;
+ for (i=old+1;i<m->count;i++) {
+  const struct k3_a1_csr_measured_entry *e=&m->entry[i];
+  if ((e->prot & K3_A1_CSR_A) || (e->prot & K3_A1_CSR_LOCK))
+   return K3_A1_PF_NO_SLOTS;
+  free_mask |= (uint16_t)(1U<<i);
+ }
+ fallback=m->count-1;
+ /* Need a fallback after all Keystone deny slots and at least two
+  * independent slots for SM + dynamic Enclave denial. */
+ if (fallback <= old+2 || __builtin_popcount((unsigned int)free_mask)<3)
+  return K3_A1_PF_NO_SLOTS;
+ out->old_allow=old;
+ out->fallback=fallback;
+ out->firmware_entries=fw;
+ out->free_keystone_entries=free_mask;
+ return K3_A1_PF_OK;
+}
+#endif
diff --git a/include/sbi/k3_e2_hart_quarantine.h b/include/sbi/k3_e2_hart_quarantine.h
new file mode 100644
index 00000000..b847a0d5
--- /dev/null
+++ b/include/sbi/k3_e2_hart_quarantine.h
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* K3 E2: Hart admission ledger. These are SOFTWARE states, not PMP proofs.
+ * Initial STOPPED is quarantine, never an ACK. A successful local CSR
+ * snapshot is diagnostic only and does not authorize an S/U-mode entry.
+ * No production code may publish `verified` until the verified A1 PMP
+ * transaction and CSR comparison have been connected.
+ */
+#ifndef __K3_E2_HART_QUARANTINE_H__
+#define __K3_E2_HART_QUARANTINE_H__
+#include <stdint.h>
+
+#define K3_E2_HART_COUNT 16U
+#define K3_E2_FULL_MASK UINT16_C(0xffff)
+#define K3_E2_OK 0
+#define K3_E2_BAD -1
+#define K3_E2_DENY -2
+#define K3_E2_BUSY -3
+
+struct k3_e2_ledger {
+ unsigned int lock;
+ uint16_t present, stopped, pending, snapshot, verified, running;
+ uint64_t epoch;
+ uint64_t proof_epoch[K3_E2_HART_COUNT];
+ unsigned int initialized, poisoned;
+};
+
+static inline int k3_e2_lock(struct k3_e2_ledger *s)
+{
+ unsigned int expected=0;
+ return s && __atomic_compare_exchange_n(&s->lock,&expected,1,0,
+                  __ATOMIC_ACQUIRE,__ATOMIC_RELAXED) ? 0 : K3_E2_BUSY;
+}
+static inline void k3_e2_unlock(struct k3_e2_ledger *s)
+{ __atomic_store_n(&s->lock,0,__ATOMIC_RELEASE); }
+/* Coldboot-only; under OpenSBI coldboot sequencing, before starting other
+ * Harts. All 16 Hart indices MUST be present. No phantom/DTB-only ACK. */
+static inline int k3_e2_cold_init(struct k3_e2_ledger *s,
+                                    uint16_t actual_harts, unsigned boot_hart)
+{
+ unsigned i;
+ if (!s || boot_hart >= K3_E2_HART_COUNT ||
+     actual_harts!=K3_E2_FULL_MASK || s->initialized) return K3_E2_BAD;
+ s->present=actual_harts;
+ s->stopped=actual_harts & (uint16_t)~(1U<<boot_hart);
+ s->pending=(uint16_t)(1U<<boot_hart);
+ s->snapshot=s->verified=s->running=0;
+ s->epoch=0; s->poisoned=0;
+ for (i=0;i<K3_E2_HART_COUNT;i++) s->proof_epoch[i]=0;
+ __atomic_store_n(&s->initialized,1,__ATOMIC_RELEASE);
+ return K3_E2_OK;
+}
+/* Must be serialized with the HSM STOP/START transition AND the global
+ * Keystone protection publisher. Caller guarantees protection INACTIVE
+ * until HSM Start finishes; fail if this cannot be established. */
+static inline int k3_e2_reserve_start(struct k3_e2_ledger *s,unsigned hart)
+{
+ uint16_t bit;
+ if (!s || hart>=K3_E2_HART_COUNT) return K3_E2_BAD;
+ if (k3_e2_lock(s)) return K3_E2_BUSY;
+ bit=(uint16_t)(1U<<hart);
+ if (!s->initialized || s->poisoned || !(s->present&bit) ||
+     !(s->stopped&bit) || (s->pending&bit) || s->epoch) {
+  k3_e2_unlock(s);return K3_E2_DENY;
+ }
+ s->stopped &= (uint16_t)~bit;
+ s->pending |= bit;
+ s->snapshot &= (uint16_t)~bit;
+ s->verified &= (uint16_t)~bit;
+ s->proof_epoch[hart]=0;
+ k3_e2_unlock(s); return K3_E2_OK;
+}
+static inline int k3_e2_cancel_start(struct k3_e2_ledger *s,unsigned hart)
+{
+ uint16_t bit;
+ if (!s || hart>=K3_E2_HART_COUNT) return K3_E2_BAD;
+ if (k3_e2_lock(s)) return K3_E2_BUSY;
+ bit=(uint16_t)(1U<<hart);
+ if (!s->initialized || s->poisoned || !(s->pending&bit)) {
+  k3_e2_unlock(s);return K3_E2_DENY;
+ }
+ s->pending &= (uint16_t)~bit;
+ s->stopped |= bit;
+ s->snapshot &= (uint16_t)~bit;
+ s->verified &= (uint16_t)~bit;
+ s->proof_epoch[hart]=0;
+ k3_e2_unlock(s); return K3_E2_OK;
+}
+/* Snapshot is an observation, not proof of A1 first-match enforcement. */
+static inline int k3_e2_note_snapshot(struct k3_e2_ledger *s,unsigned hart)
+{
+ uint16_t bit;
+ if (!s || hart>=K3_E2_HART_COUNT) return K3_E2_BAD;
+ if (k3_e2_lock(s)) return K3_E2_BUSY;
+ bit=(uint16_t)(1U<<hart);
+ if (!s->initialized || s->poisoned || !(s->pending&bit)) {
+  k3_e2_unlock(s);return K3_E2_DENY;
+ }
+ s->snapshot |= bit;
+ k3_e2_unlock(s);return K3_E2_OK;
+}
+/* No firmware caller: future verified A1 transaction must supply an epoch
+ * only after shadow+deny+old-allow removal+CSR readback on this Hart. */
+static inline int k3_e2_verified_local(struct k3_e2_ledger *s,unsigned hart,
+                                       uint64_t epoch, int csr_exact_match)
+{
+ uint16_t bit;
+ if (!s || hart>=K3_E2_HART_COUNT) return K3_E2_BAD;
+ if (k3_e2_lock(s)) return K3_E2_BUSY;
+ bit=(uint16_t)(1U<<hart);
+ if (!s->initialized || s->poisoned || !epoch ||
+     epoch!=s->epoch || !csr_exact_match ||
+     !(s->pending&bit) || !(s->snapshot&bit)) {
+  k3_e2_unlock(s);return K3_E2_DENY;
+ }
+ s->verified |= bit;
+ s->proof_epoch[hart]=epoch;
+ k3_e2_unlock(s);return K3_E2_OK;
+}
+/* Initial HSM Start is NOT a dynamic PMP update: each Hart must first
+ * successfully configure and read back its local OpenSBI PMP layout, pass
+ * the A1-E local preflight, and record a snapshot. No cross-Hart IPI or
+ * dynamic epoch is required at boot. Once a dynamic epoch exists, an
+ * unproved Start remains denied; snapshot is NOT an epoch ACK.
+ */
+static inline int k3_e2_finish_start(struct k3_e2_ledger *s,unsigned hart)
+{
+ uint16_t bit;
+ if (!s || hart>=K3_E2_HART_COUNT) return K3_E2_BAD;
+ if (k3_e2_lock(s)) return K3_E2_BUSY;
+ bit=(uint16_t)(1U<<hart);
+ if (!s->initialized || s->poisoned || !(s->present&bit) ||
+     !(s->pending&bit) || !(s->snapshot&bit) || (s->running&bit)) {
+  k3_e2_unlock(s);return K3_E2_DENY;
+ }
+ if (!s->epoch) {
+  /* First boot only: proof_epoch=0 and verified=0 are intentional. */
+  if ((s->verified&bit) || s->proof_epoch[hart]) {
+   k3_e2_unlock(s);return K3_E2_DENY;
+  }
+ } else if (!(s->verified&bit) ||
+            s->proof_epoch[hart]!=s->epoch) {
+  /* Never treat a boot snapshot as proof of a dynamic PMP epoch. */
+  k3_e2_unlock(s);return K3_E2_DENY;
+ }
+ s->pending &= (uint16_t)~bit;
+ s->running |= bit;
+ k3_e2_unlock(s);return K3_E2_OK;
+}
+/* Only safe after the real STOPPED transition; future starts must replay. */
+static inline int k3_e2_mark_stopped(struct k3_e2_ledger *s,unsigned hart)
+{
+ uint16_t bit;
+ if (!s || hart>=K3_E2_HART_COUNT) return K3_E2_BAD;
+ if (k3_e2_lock(s)) return K3_E2_BUSY;
+ bit=(uint16_t)(1U<<hart);
+ if (!s->initialized || s->poisoned || !(s->running&bit)) {
+  k3_e2_unlock(s);return K3_E2_DENY;
+ }
+ s->running &= (uint16_t)~bit;
+ s->stopped |= bit;
+ s->verified &= (uint16_t)~bit;
+ s->snapshot &= (uint16_t)~bit;
+ s->proof_epoch[hart]=0;
+ k3_e2_unlock(s);return K3_E2_OK;
+}
+/* Classify a Hart at dynamic PMP update target capture. Initial STARTED
+ * Harts have local boot PMP evidence (snapshot), not a dynamic-epoch ACK.
+ * All STARTED Harts remain targets for the first real IPI transaction;
+ * no synthetic ACK is created. Unexpected/pending states fail closed.
+ * Return 0=STOPPED quarantine, 1=STARTED target, negative=reject. */
+static inline int k3_e2_classify_target(struct k3_e2_ledger *s,
+                                       unsigned hart, int hsm_state)
+{
+ uint16_t bit;
+ int rc=K3_E2_DENY;
+ if (!s || hart>=K3_E2_HART_COUNT) return K3_E2_BAD;
+ if (k3_e2_lock(s)) return K3_E2_BUSY;
+ bit=(uint16_t)(1U<<hart);
+ if (!s->initialized || s->poisoned || !(s->present&bit) ||
+     (s->pending&bit)) goto done;
+ if (hsm_state==0 && (s->stopped&bit) && !(s->running&bit))
+  rc=0;
+ else if (hsm_state==1 && (s->running&bit) &&
+          (s->snapshot&bit) &&
+          ((!s->epoch && !(s->verified&bit) && !s->proof_epoch[hart]) ||
+           (s->epoch && (s->verified&bit) &&
+            s->proof_epoch[hart]==s->epoch)))
+  rc=1;
+done:
+ k3_e2_unlock(s);
+ return rc;
+}
+/* Future global coordinator ONLY. No production publisher in this stage.
+ * Fail closed if any start is pending, local PMP is unknown, or running
+ * Harts' readback doesn't match. STOPPED Harts are quarantined, not ACKed;
+ * the HSM protection gate MUST reject starts while enclaves exist. */
+static inline int k3_e2_can_activate(const struct k3_e2_ledger *s)
+{
+ unsigned i;
+ uint16_t running;
+ if (!s || !s->initialized || s->poisoned || !s->epoch ||
+     s->pending || !s->running ||
+     (uint16_t)(s->running|s->stopped)!=s->present ||
+     s->verified!=s->running) return K3_E2_DENY;
+ running=s->running;
+ for (i=0;i<K3_E2_HART_COUNT;i++)
+  if ((running&(1U<<i)) && s->proof_epoch[i]!=s->epoch)
+   return K3_E2_DENY;
+ return K3_E2_OK;
+}
+#endif
diff --git a/include/sbi/k3_keystone_boot_slots.h b/include/sbi/k3_keystone_boot_slots.h
new file mode 100644
index 00000000..2a89b16b
--- /dev/null
+++ b/include/sbi/k3_keystone_boot_slots.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Jupiter2 QEMU-only deterministic 16-PMP boot slot layout.
+ * Every root-domain entry (denies and grants) precedes Keystone free slots;
+ * the root-domain universal S/U allow is always index 15.
+ * This is a slot plan, not a substitute for hardware CSR readback.
+ */
+#ifndef __K3_KEYSTONE_BOOT_SLOTS_H__
+#define __K3_KEYSTONE_BOOT_SLOTS_H__
+#include <stdint.h>
+#define K3_BOOT_PMP_COUNT 16U
+#define K3_BOOT_FALLBACK 15U
+#define K3_BOOT_MIN_KEYSTONE 3U
+struct k3_boot_pmp_plan {
+ uint16_t opensbi_mask;
+ uint16_t keystone_mask;
+ uint8_t firmware_entries;
+ uint8_t fallback_index;
+};
+static inline int k3_boot_plan_slots(unsigned int pmp_count,
+ unsigned int firmware_entries, unsigned int broad_allow_entries,
+ struct k3_boot_pmp_plan *out)
+{
+ unsigned int i;
+ uint16_t reserved = (uint16_t)(1U << K3_BOOT_FALLBACK);
+ if (!out || pmp_count != K3_BOOT_PMP_COUNT ||
+     !firmware_entries || broad_allow_entries != 1U ||
+     firmware_entries + K3_BOOT_MIN_KEYSTONE > K3_BOOT_FALLBACK)
+  return -1;
+ for (i = 0; i < firmware_entries; i++) reserved |= (uint16_t)(1U << i);
+ out->firmware_entries = (uint8_t)firmware_entries;
+ out->fallback_index = K3_BOOT_FALLBACK;
+ out->opensbi_mask = reserved;
+ out->keystone_mask = (uint16_t)(0xffffU & ~reserved);
+ return 0;
+}
+#endif
diff --git a/include/sbi/k3_pmp_partition_evidence.h b/include/sbi/k3_pmp_partition_evidence.h
new file mode 100644
index 00000000..016243a9
--- /dev/null
+++ b/include/sbi/k3_pmp_partition_evidence.h
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* K3 Stage 207: pure, fail-closed PMP partition evidence validator.
+ * No PMP writes; NOT an authorization to hand off ownership or boot SM.
+ * This checks caller-supplied snapshots only. An M-mode CSR inventory and
+ * cross-hart synchronization must supply and attest the evidence in future.
+ */
+#ifndef K3_PMP_PARTITION_EVIDENCE_H
+#define K3_PMP_PARTITION_EVIDENCE_H
+
+#include <stdint.h>
+
+#define K3_PMP_EVIDENCE_MAX_HARTS 16U
+#define K3_PMP_EVIDENCE_MAX_REGS  16U
+
+enum k3_pmp_evidence_result {
+ K3_PMP_EVIDENCE_OK = 0,
+ K3_PMP_EVIDENCE_BAD_INPUT = -1,
+ K3_PMP_EVIDENCE_UNVERIFIED = -2,
+ K3_PMP_EVIDENCE_OVERLAP = -3,
+ K3_PMP_EVIDENCE_OUT_OF_RANGE = -4,
+ K3_PMP_EVIDENCE_ACTIVE_UNOWNED = -5,
+ K3_PMP_EVIDENCE_LOCKED_KEYSTONE = -6,
+ K3_PMP_EVIDENCE_NONUNIFORM = -7,
+ K3_PMP_EVIDENCE_NO_CAPACITY = -8,
+ K3_PMP_EVIDENCE_PRIORITY_UNKNOWN = -9,
+ K3_PMP_EVIDENCE_PRIORITY_CONFLICT = -10,
+ K3_PMP_EVIDENCE_DYNAMIC_PRIORITY_UNKNOWN = -11,
+ K3_PMP_EVIDENCE_DYNAMIC_PRIORITY_CONFLICT = -12
+};
+
+/* Bit positions are PMP entry numbers, not hart IDs. No CSR is read here. */
+struct k3_pmp_hart_evidence {
+ uint8_t present;
+ uint8_t pmp_count;
+ uint8_t csr_snapshot_verified;
+ uint8_t legacy_pmp_mode_verified;
+ uint16_t opensbi_reserved; /* Includes every active pre-handoff entry. */
+ uint16_t keystone_reserved; /* Disjoint from OpenSBI, fixed for this boot. */
+ uint16_t active_entries;   /* PMP A!=OFF from verified CSR snapshot. */
+ uint16_t locked_entries;   /* PMP L bit from verified CSR snapshot. */
+ /* Measurements of FIRST-MATCH PMP priority over the exact SM range.
+  * Never infer them from allocation masks or DTB. */
+ uint8_t sm_priority_verified;
+ uint16_t prior_su_allow_sm_overlap; /* active earlier permissive rules */
+ /* Does any lower-index OpenSBI permissive PMP match a possible dynamic
+  * Enclave address before the Keystone deny region? Include all-RAM allow.
+  * Requires actual root domain/PMP range analysis, not just CSR mask bits. */
+ uint8_t dynamic_priority_verified;
+ uint16_t prior_su_allow_dynamic_overlap;
+};
+
+struct k3_pmp_partition_evidence {
+ uint8_t hart_count; /* K3: exactly 16 Hart indices; no assumptions on IDs */
+ struct k3_pmp_hart_evidence hart[K3_PMP_EVIDENCE_MAX_HARTS];
+};
+
+/* No trust decision may be made on an absent/partial CSR measurement. */
+static inline int k3_pmp_validate_partition_evidence(
+ const struct k3_pmp_partition_evidence *e)
+{
+ unsigned int i;
+ if (!e || e->hart_count != K3_PMP_EVIDENCE_MAX_HARTS)
+  return K3_PMP_EVIDENCE_BAD_INPUT;
+ for (i = 0; i < K3_PMP_EVIDENCE_MAX_HARTS; i++) {
+  const struct k3_pmp_hart_evidence *h = &e->hart[i];
+  uint32_t valid;
+  if (!h->present || h->pmp_count == 0 ||
+      h->pmp_count > K3_PMP_EVIDENCE_MAX_REGS)
+   return K3_PMP_EVIDENCE_BAD_INPUT;
+#ifdef K3_QEMU_PMP16
+  /* Reject a mixed or under-provisioned virtual Hart. Fail closed. */
+  if (h->pmp_count != 16U) return K3_PMP_EVIDENCE_BAD_INPUT;
+#endif
+  if (!h->csr_snapshot_verified || !h->legacy_pmp_mode_verified)
+   return K3_PMP_EVIDENCE_UNVERIFIED;
+  valid = (1U << h->pmp_count) - 1U;
+  if (((uint32_t)(h->opensbi_reserved | h->keystone_reserved |
+                   h->active_entries | h->locked_entries) & ~valid) != 0)
+   return K3_PMP_EVIDENCE_OUT_OF_RANGE;
+  if (!h->keystone_reserved || (h->opensbi_reserved & h->keystone_reserved))
+   return K3_PMP_EVIDENCE_OVERLAP;
+  if (h->active_entries & ~h->opensbi_reserved)
+   return K3_PMP_EVIDENCE_ACTIVE_UNOWNED;
+  if (h->locked_entries & h->keystone_reserved)
+   return K3_PMP_EVIDENCE_LOCKED_KEYSTONE;
+ }
+ return K3_PMP_EVIDENCE_OK;
+}
+
+/* Returns 1 only if a fixed identical Keystone slot set works on all harts.
+ * A failure is evidence for *investigation*, not a reason to loosen guards. */
+static inline int k3_pmp_partition_has_uniform_keystone_slots(
+ const struct k3_pmp_partition_evidence *e)
+{
+ unsigned int i;
+ uint16_t mask;
+ if (k3_pmp_validate_partition_evidence(e) != K3_PMP_EVIDENCE_OK)
+  return 0;
+ mask = e->hart[0].keystone_reserved;
+ for (i = 1; i < K3_PMP_EVIDENCE_MAX_HARTS; i++)
+  if (e->hart[i].keystone_reserved != mask) return 0;
+ return 1;
+}
+
+/* Candidate A: both OpenSBI AND Keystone use identical fixed slot numbers.
+ * Require an actual CSR-backed check of first-match precedence: a lower
+ * OpenSBI PMP allow rule must not shadow the Keystone SM deny region.
+ * Synthetic callers can test this validator, but cannot certify hardware. */
+static inline int k3_pmp_validate_uniform_partition(
+ const struct k3_pmp_partition_evidence *e, uint16_t *keystone_mask)
+{
+ unsigned int i;
+ uint16_t osm, ksm;
+ int ret = k3_pmp_validate_partition_evidence(e);
+ if (ret != K3_PMP_EVIDENCE_OK) return ret;
+ osm = e->hart[0].opensbi_reserved;
+ ksm = e->hart[0].keystone_reserved;
+ /* SM deny, OS allow and at least one dynamic Enclave region. */
+ if (!osm || __builtin_popcount((unsigned int)ksm) < 3)
+  return K3_PMP_EVIDENCE_NO_CAPACITY;
+ for (i = 0; i < K3_PMP_EVIDENCE_MAX_HARTS; ++i) {
+  const struct k3_pmp_hart_evidence *h = &e->hart[i];
+  if (h->opensbi_reserved != osm || h->keystone_reserved != ksm)
+   return K3_PMP_EVIDENCE_NONUNIFORM;
+  if (!h->sm_priority_verified)
+   return K3_PMP_EVIDENCE_PRIORITY_UNKNOWN;
+  if (h->prior_su_allow_sm_overlap)
+   return K3_PMP_EVIDENCE_PRIORITY_CONFLICT;
+  if (!h->dynamic_priority_verified)
+   return K3_PMP_EVIDENCE_DYNAMIC_PRIORITY_UNKNOWN;
+  if (h->prior_su_allow_dynamic_overlap)
+   return K3_PMP_EVIDENCE_DYNAMIC_PRIORITY_CONFLICT;
+ }
+ if (keystone_mask) *keystone_mask = ksm;
+ return K3_PMP_EVIDENCE_OK;
+}
