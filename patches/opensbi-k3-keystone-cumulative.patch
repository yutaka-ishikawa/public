+static bool k3_root_is_global_allow(const struct sbi_domain_memregion *r)
+{
+ return r->base == 0 && r->order == __riscv_xlen &&
+        (r->flags & SBI_DOMAIN_MEMREGION_SU_ACCESS_MASK) ==
+          (SBI_DOMAIN_MEMREGION_SU_READABLE |
