+ if (r->flags & SBI_DOMAIN_MEMREGION_SU_READABLE)
+  prot |= PMP_R;
+ if (r->flags & SBI_DOMAIN_MEMREGION_SU_WRITABLE)
+  prot |= PMP_W;
+ if (r->flags & SBI_DOMAIN_MEMREGION_SU_EXECUTABLE)
+  prot |= PMP_X;
+ return prot;
