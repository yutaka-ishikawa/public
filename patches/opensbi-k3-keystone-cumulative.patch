diff --git a/scripts/k3_keystone_policy_audit.py b/scripts/k3_keystone_policy_audit.py
new file mode 100644
index 00000000..a02e95d2
--- /dev/null
+++ b/scripts/k3_keystone_policy_audit.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Policy regression gate for K3 Keystone; source-level guarantees only."""
+import argparse
+from pathlib import Path
+import re
+import sys
+
+
+def function_body(src, function):
+    m = re.search(r'\b(?:static\s+)?(?:int|void|bool)\s+' + re.escape(function) + r'\s*\([^;]*?\)\s*\{', src, re.S)
+    if not m:
+        raise ValueError('missing function '+function)
+    start=m.end(); depth=1
+    for j in range(start,len(src)):
+        if src[j]=='{': depth+=1
+        if src[j]=='}': depth-=1
+        if depth==0: return src[start:j]
+    raise ValueError('unterminated function '+function)
+
+
+def audit(root):
+    failures=[]; results=[]
+    def check(label, ok):
+        results.append((label,ok))
+        if not ok: failures.append(label)
+    hart=(root/'lib/sbi/sbi_hart.c').read_text()
+    kconfig=(root/'platform/generic/Kconfig').read_text()
+    pmp=function_body(hart,'sbi_hart_pmp_configure')
+    kbranch=re.search(r'#ifdef CONFIG_K3_KEYSTONE_SM(.*?)#else(.*?)#endif',pmp,re.S)
+    check('Keystone PMP configure branch exists',kbranch is not None)
+    if kbranch:
+        ks=kbranch.group(1)
+        check('Keystone uses deterministic boot slot layout', 'k3_keystone_root_pmp_configure(' in ks and 'k3_boot_plan_slots' in hart)
+        check('No Smepmp capability-based rejection in Keystone PMP init', not re.search(r'SBI_HART_EXT_SMEPMP|SBI_ENOTSUPP',ks))
+        check('No Smepmp initializer in Keystone PMP init', 'sbi_hart_smepmp_configure(' not in ks)
+        check('Vendor Smepmp path retained', 'sbi_hart_smepmp_configure(' in kbranch.group(2))
+    check('Kconfig explicit PMP mode choice', bool(re.search(r'choice\s+prompt "K3 PMP policy selection".*?config K3_PMP_VENDOR.*?config K3_PMP_SMEPMP.*?config K3_KEYSTONE_SM.*?endchoice',kconfig,re.S)))
+    init=(root/'lib/sbi/sbi_init.c').read_text()
+    check('Keystone runtime admission remains fail-closed',
+          'k3_keystone_a1_post_pmp_before_smode' in init and
+          'k3_pmp_boot_partition_admit(' in init and
+          'sm_init unavailable' in init and
+          'sbi_hart_hang();' in init)
+    check('Smepmp setter remains void', bool(re.search(r'static void sbi_hart_smepmp_set\(',hart)))
+    check('Keystone buffer access helpers preserved', all('sbi_hart_'+n+'_saddr' in hart for n in ('map','unmap')))
+    map_body=function_body(hart,'sbi_hart_map_saddr')
+    unmap_body=function_body(hart,'sbi_hart_unmap_saddr')
+    check('Legacy Smepmp capability-based helper removed', 'k3_keystone_sbi_buffer_access_permitted' not in hart)
+    check('Keystone map has explicit no-mapping branch', bool(re.search(r'#ifdef CONFIG_K3_KEYSTONE_SM.*?return SBI_OK;.*?#else',map_body,re.S)))
+    check('Keystone unmap has explicit no-mapping branch', bool(re.search(r'#else.*?return SBI_OK;.*?#endif',unmap_body,re.S)))
+    check('Keystone buffer map not keyed to hardware extension', 'SBI_HART_EXT_SMEPMP' not in re.search(r'#ifdef CONFIG_K3_KEYSTONE_SM(.*?)#else',map_body,re.S).group(1))
+    check('Keystone buffer unmap not keyed to hardware extension', 'SBI_HART_EXT_SMEPMP' not in re.search(r'#else(.*?)#endif',unmap_body,re.S).group(1))
+    return results,failures
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(); parser.add_argument('root',type=Path);args=parser.parse_args()
+    try: results,failures=audit(args.root)
+    except (OSError,ValueError) as e: print('AUDIT ERROR:',e);sys.exit(2)
+    for name,ok in results:print(('PASS' if ok else 'FAIL')+' '+name)
+    print(f'TOTAL {len(results)} tests, {len(failures)} failure(s)')
+    sys.exit(1 if failures else 0)
diff --git a/scripts/k3_pmp_diag_check.py b/scripts/k3_pmp_diag_check.py
new file mode 100644
index 00000000..7d66ff48
--- /dev/null
+++ b/scripts/k3_pmp_diag_check.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Validate K3 read-only OpenSBI PMP inventory LOG COMPLETENESS only.
+
+A PASS is not PMP partition approval, an IOPMP/DMA check, or attestation.
+K3 Harts that remain HSM STOPPED cannot emit a CSR inventory; do not infer
+an ACK or PMP correctness for them. Hart IDs need not equal Hart indices.
+"""
+import argparse
+import json
+import re
+from pathlib import Path
+
+LINE = re.compile(r'^K3_PMP_DIAG hart=(\d+) (.*)$')
+FIELD = re.compile(r'([a-zA-Z0-9_]+)=([^ ]+)')
+
+
+def inspect(log: str, expected: int = 16) -> dict:
+    records = {}
+    errors = []
+    for lineno, line in enumerate(log.splitlines(), 1):
+        match = LINE.search(line.strip())
+        if not match:
+            continue
+        hart = int(match.group(1))
+        data = dict(FIELD.findall(match.group(2)))
+        if not data:
+            errors.append(f'line {lineno}: unrecognized diagnostic record')
+            continue
+        # Last full inventory per Hart can be used after resume. Do not merge
+        # different boot/resume snapshots with each other.
+        if 'count' in data:
+            if hart in records and not records[hart]['end']:
+                errors.append(f'line {lineno}: incomplete previous snapshot hart {hart}')
+            try:
+                count = int(data['count'], 0)
+                gran = int(data['gran'], 0)
+                smepmp = int(data['smepmp'], 0)
+            except (ValueError, KeyError):
+                errors.append(f'line {lineno}: invalid header')
+                continue
+            if count < 1 or count > 64 or gran > 64 or smepmp not in (0, 1):
+                errors.append(f'line {lineno}: impossible PMP header')
+            records[hart] = {'count': count, 'gran': gran,
+                             'smepmp': smepmp, 'entries': set(),
+                             'end': False, 'mseccfg': False}
+            continue
+        item = records.get(hart)
+        if item is None:
+            errors.append(f'line {lineno}: data before header for hart {hart}')
+            continue
+        if 'end' in data:
+            if data['end'] != '1' or item['end']:
+                errors.append(f'line {lineno}: duplicate/invalid end hart {hart}')
+            item['end'] = True
+        elif 'mseccfg' in data:
+            if item['mseccfg'] or item['end']:
+                errors.append(f'line {lineno}: duplicate/out-of-order mseccfg')
+            item['mseccfg'] = True
+        elif 'idx' in data:
+            try:
+                index = int(data['idx'], 0)
+                if 'error' in data or not all(k in data for k in ('prot', 'base', 'log2len')):
+                    raise ValueError('CSR read error')
+                int(data['prot'], 0)
+                int(data['base'], 0)
+                int(data['log2len'], 0)
+            except ValueError:
+                errors.append(f'line {lineno}: invalid CSR entry hart {hart}')
+                continue
+            if index < 0 or index >= item['count'] or index in item['entries'] or item['end']:
+                errors.append(f'line {lineno}: duplicate/unexpected index hart {hart}')
+            item['entries'].add(index)
+        else:
+            errors.append(f'line {lineno}: unknown record')
+    good = []
+    for hart, item in sorted(records.items()):
+        if (not item['end'] or item['entries'] != set(range(item['count'])) or
+                (item['smepmp'] and not item['mseccfg'])):
+            errors.append(f'incomplete Hart {hart} snapshot: {len(item["entries"])}/{item["count"]} entries')
+        else:
+            good.append(hart)
+    if len(records) != expected:
+        errors.append(f'expected {expected} unique Hart snapshots, got {len(records)}')
+    return {'inventory_complete': not errors, 'NOT_SECURITY_PROOF': True,
+            'expected_harts': expected, 'complete_hartids': good,
+            'observed_hartids': sorted(records), 'errors': errors}
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('serial_log', type=Path)
+    ap.add_argument('--expected-harts', type=int, default=16)
+    args = ap.parse_args()
+    if args.expected_harts < 1 or args.expected_harts > 16:
+        ap.error('expected Hart count must be in 1..16')
+    report = inspect(args.serial_log.read_text(errors='replace'), args.expected_harts)
+    print(json.dumps(report, ensure_ascii=False, indent=2))
+    return 0 if report['inventory_complete'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
